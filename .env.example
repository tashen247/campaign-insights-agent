# Required for a live run. Leave empty and use --offline for the model-free baseline.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# hermetic (default) gives the Claude Code subprocess a minimal env; inherit passes the full parent env
AGENT_ENV=hermetic

# Mocks by default: fixtures in, files in runs/<id>/ out
MOCK_MODE=true
SCENARIO=meta_install_drop

# Limits
MAX_BUDGET_USD=0.50
MAX_TURNS=20
MAX_TOOL_CALLS=25
MAX_ASANA_TASKS=5
REQUIRE_APPROVAL=false

PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Real integrations (MOCK_MODE=false)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CAMPAIGN_PROPERTY=campaign_id
ASANA_PAT=
ASANA_PROJECT_GID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Comma-separated. The agent can only ever post to SLACK_CHANNEL_ID, and only if it is listed here.
SLACK_ALLOWED_CHANNELS=
